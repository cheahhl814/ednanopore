manifest {
    name            = 'nf-edna-nanopore'
    author          = 'Cheah Hong Leong'
    description     = 'Nanopore 16S eDNA metabarcoding pipeline — consensus (main-consensus.nf) or read-based (main-readbased.nf) variant, selected via -entry / mainScript at launch'
    mainScript      = 'main-consensus.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '0.1.0'
}

params {
    // Run identity
    run_id          = "edna-nanopore-${new java.util.Date().format('yyyyMMdd-HHmmss')}"
    results_dir     = "${launchDir}/results"

    // Inputs
    input_manifest  = ""
    metadata        = ""

    // Marker identity and amplicon geometry — must be supplied via -params-file preset
    marker          = ""
    primers_fwd     = ""
    primers_rev     = ""
    min_length      = 0
    max_length      = 0
    min_qual        = 10
    kingdoms        = ""

    // Pipeline variant (informational at the Nextflow layer — the orchestrating
    // skill picks main-consensus.nf vs. main-readbased.nf; this param is still
    // written into pipeline_state.json for provenance)
    pipeline_variant = "consensus"

    // Classification — shared by both variants
    // classifier: "minimap2" (default) | "kraken2" | "idtaxa" (consensus variant only)
    classifier          = "minimap2"
    ref_mmi             = ""
    tax_lookup          = ""
    kraken2_db          = ""
    idtaxa_model        = ""
    minimap2_min_ref_coverage    = 0.8
    minimap2_min_pct_identity    = 0.97
    // 60% mirrors nf-edna's IDTAXA default (Murali et al. 2018, Microbiome);
    // only used when classifier == "idtaxa"
    idtaxa_threshold    = 60

    // Consensus variant only — clustering + polishing
    medaka_model                 = ""
    cluster_min_identity         = 0.85
    cluster_min_coverage_fraction = 0.8
    yacrd_min_coverage           = 0.4
    yacrd_min_length             = 100

    // Decontam
    decontam_threshold  = 0.1
    neg_col             = "is_negative"
    filter_condition    = "is_negative == false"

    // Diversity (consensus variant only, v1)
    grouping_variable           = ""
    distance_metric             = "bray"
    clustering_method           = "ward.D2"
    num_clusters                = ""
    metadata_numeric_variables  = ""

    // Association (consensus variant only, v1)
    reference_level     = ""
    daa_level           = "Genus"
    correlation_level   = "Genus"
    top_n_taxa_plot     = 20
    target_ranks        = "Phylum,Family,Genus"

    // Geocuration (consensus variant only, opt-in)
    geocurate        = false
    geocurate_coords = ""
    geocurate_buffer = 500
}

process {
    cpus   = { check_max(1 * task.attempt, 'cpus') }
    memory = { check_max(6.GB * task.attempt, 'memory') }
    time   = { check_max(4.h * task.attempt, 'time') }

    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_low {
        cpus   = { check_max(4 * task.attempt, 'cpus') }
        memory = { check_max(12.GB * task.attempt, 'memory') }
        time   = { check_max(4.h * task.attempt, 'time') }
    }
    withLabel: process_medium {
        cpus   = { check_max(8 * task.attempt, 'cpus') }
        memory = { check_max(36.GB * task.attempt, 'memory') }
        time   = { check_max(8.h * task.attempt, 'time') }
    }
}

def check_max(obj, type) {
    if (type == 'memory') {
        try { if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1) return params.max_memory as nextflow.util.MemoryUnit
              else return obj } catch (all) { return obj }
    } else if (type == 'time') {
        try { if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1) return params.max_time as nextflow.util.Duration
              else return obj } catch (all) { return obj }
    } else if (type == 'cpus') {
        try { return Math.min(obj, params.max_cpus as int) } catch (all) { return obj }
    }
}

params.max_memory = '128.GB'
params.max_cpus   = 16
params.max_time   = '240.h'
